# Names only. Put real values in the server stack .env, never in git.
PORT_HOST=8044                 # host port = container port (port register: mealkit-manager 8044)
FAST_STORAGE=                  # optional; defaults to the appdata-ssd path in compose.yaml
MEALKIT_APP_PASSWORD=          # optional HTTP Basic password for the portal (any username)
MEALKIT_SECRET_KEY=            # 16+ random characters; required only to link accounts. Keep a backup: if it changes, logins must be entered again
HORIZON_WEEKS=12               # default planning horizon
SYNC_HOURS=6                   # hours between background reads of linked accounts (0 = off)
AUTOMATION=on                  # off stops all reading and changing of linked accounts
